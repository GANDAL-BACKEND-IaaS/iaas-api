# Remplacez ce secret de developpement par une valeur longue hors de la machine locale.
IAM_JWT_SECRET=replace-with-a-long-random-secret
# IAM_TOKEN_TTL_SECONDS=3600

# Base locale. Sous Docker Compose, DATABASE_URL est injecte et pointe vers PostgreSQL.
# DATABASE_URL=sqlite:///./dev.db

# Comptes de demonstration du mock IAM. A desactiver hors developpement.
# IAM_SEED_DEMO_USERS=true
